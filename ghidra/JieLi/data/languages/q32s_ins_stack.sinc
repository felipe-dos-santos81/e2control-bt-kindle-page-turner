popl: "r9-r4" is ins0003=9 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); }
popl: "r10-r4" is ins0003=10 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); pop(r10); }
popl: "r11-r4" is ins0003=11 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); pop(r10); pop(r11); }
popl: "r12-r4" is ins0003=12 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); pop(r10); pop(r11); pop(r12); }
popl: "r13-r4" is ins0003=13 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); pop(r10); pop(r11); pop(r12); pop(r13); }
popl: "r14-r4" is ins0003=14 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); pop(r10); pop(r11); pop(r12); pop(r13); pop(r14); }
popl: "r15-r4" is ins0003=15 { pop(r4); pop(r5); pop(r6); pop(r7); pop(r8); pop(r9); pop(r10); pop(r11); pop(r12); pop(r13); pop(r14); pop(r15); }

:pop {popl} is group=0 & ins0412=0x010 & popl { build popl; }
:pop {rets, popl} is group=0 & ins0412=0x011 & popl & rets { build popl; pop(rets); }
:pop {pc, popl} is group=0 & ins0412=0x015 & popl & pc { build popl; pop(pc); return [pc]; }
:push {pushl} is group=0 & ins0412=0x016 & pushl { build pushl; }
:push {rets, pushl} is group=0 & ins0412=0x017 & pushl & rets { push(rets); build pushl; }

# Seen in ROM interrupt handlers (rom.lst), exact encodings only.
:pop {rets} is group=0 & ins0012=0x0188 & rets { pop(rets); }
:push {psr, rets, reti} is group=0 & ins0012=0x01E9 & psr & rets & reti { push(psr); push(rets); push(reti); }
:pop {psr, rets, reti} is group=0 & ins0012=0x01A9 & psr & rets & reti { pop(reti); pop(rets); pop(psr); }

# 16-bit register masks (second word): f378 push / f370 pop GPRs, f37e push / f37c pop special registers.

