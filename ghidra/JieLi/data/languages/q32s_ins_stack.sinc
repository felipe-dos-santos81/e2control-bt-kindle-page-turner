pushl: "r14-r4" is ins0003=14 { push(r14); push(r13); push(r12); push(r11); push(r10); push(r9); push(r8); push(r7); push(r6); push(r5); push(r4); }
pushl: "r15-r4" is ins0003=15 { push(r15); push(r14); push(r13); push(r12); push(r11); push(r10); push(r9); push(r8); push(r7); push(r6); push(r5); push(r4); }
popl: "r3-r0" is ins0003=0 { pop(r0); pop(r1); pop(r2); pop(r3); }
popl: "r3-r1" is ins0003=1 { pop(r1); pop(r2); pop(r3); }
popl: "r3, r2" is ins0003=2 { pop(r2); pop(r3); }
popl: "r3" is ins0003=3 { pop(r3); }
popl: "r4" is ins0003=4 { pop(r4); }
popl: "r5, r4" is ins0003=5 { pop(r4); pop(r5); }
