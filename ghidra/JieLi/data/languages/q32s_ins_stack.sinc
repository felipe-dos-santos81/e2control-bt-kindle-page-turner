##################
#
# Stack Operations
#
# Register lists follow the vendor objdump (cpu/bd19/tools/rom.lst):
# low nibble N >= 4 -> {rN..r4}, N < 4 -> {r3..rN}. Highest register at the highest address.
#
##################

:pop pc is group=0 & ins0012=0x0030 & pc
{
	pop(pc);
	return [pc];
}

:push rets is group=0 & ins0012=0x0034 & rets
{
	push(rets);
}

pushl: "r3-r0" is ins0003=0 { push(r3); push(r2); push(r1); push(r0); }
pushl: "r3-r1" is ins0003=1 { push(r3); push(r2); push(r1); }
pushl: "r3, r2" is ins0003=2 { push(r3); push(r2); }
pushl: "r3" is ins0003=3 { push(r3); }
pushl: "r4" is ins0003=4 { push(r4); }
pushl: "r5, r4" is ins0003=5 { push(r5); push(r4); }
pushl: "r6-r4" is ins0003=6 { push(r6); push(r5); push(r4); }
pushl: "r7-r4" is ins0003=7 { push(r7); push(r6); push(r5); push(r4); }
