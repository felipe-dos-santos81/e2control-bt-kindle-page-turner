@@ -440,6 +440,17 @@ static void close_gpio(u8 is_softoff)
     port_protect(port_group,TCFG_ADKEY_PORT);
 #endif /* */
 
+    //E2: keep the wake-up pins as they are at soft-off (pull-up / pull-down), as the SDK does for the AD key pin
